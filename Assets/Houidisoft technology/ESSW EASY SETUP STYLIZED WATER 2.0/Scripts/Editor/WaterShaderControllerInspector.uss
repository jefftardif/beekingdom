.unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    font-size: 12px;
    opacity: 1;
    display: none;
    transition-duration: 0s;
    transition-delay: 0s;
    padding-bottom: 0;
    margin-bottom: 0;
}

.unity-foldout__toggle > .unity-foldout__input > .unity-foldout__text {
    color: rgb(219, 219, 219);
    scale: 1 1;
    -unity-font-style: bold;
    background-color: rgb(41, 41, 41);
    -unity-text-outline-color: rgba(53, 53, 53, 0.72);
    -unity-text-align: upper-left;
    letter-spacing: 1px;
    font-size: 20px;
    rotate: 0;
    transform-origin: top;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    text-overflow: clip;
    -unity-slice-left: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 10px;
    border-left-color: rgb(0, 255, 224);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    cursor: initial;
    margin-top: 5px;
    margin-right: 2px;
    margin-bottom: -5px;
    margin-left: 3px;
    padding-top: 5px;
    padding-right: 0;
    padding-bottom: 9px;
    padding-left: 11px;
    white-space: normal;
    background-size: 100% 100%;
    background-position-x: center 0;
    background-position-y: center 0;
    translate: 0 0;
    background-repeat: no-repeat no-repeat;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    word-spacing: 0;
    -unity-paragraph-spacing: 0;
}

#unity-content {
    padding-bottom: 15px;
    margin-bottom: 0;
    border-left-color: rgb(0, 255, 224);
    border-right-color: rgb(0, 255, 224);
    border-top-color: rgb(0, 255, 224);
    border-bottom-color: rgb(0, 255, 224);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 10px;
    margin-left: -9px;
    margin-top: -4px;
    background-color: rgb(41, 41, 41);
    padding-top: -1px;
    padding-right: 18px;
    font-size: 14px;
    -unity-font-style: bold;
    padding-left: 9px;
}

.unity-foldout__toggle > .unity-foldout__input :hover {
    color: rgb(136, 136, 136);
    scale: 1 1;
    -unity-font-style: bold;
    background-color: rgb(41, 41, 41);
    -unity-text-outline-color: rgba(53, 53, 53, 0.72);
    -unity-text-align: upper-left;
    letter-spacing: 10px;
    font-size: 20px;
    rotate: 0;
    transform-origin: top;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    text-overflow: clip;
    -unity-slice-left: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 10px;
    border-left-color: rgb(0, 255, 224);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    cursor: initial;
    margin-top: 5px;
    margin-right: 2px;
    margin-bottom: -5px;
    margin-left: 3px;
    padding-top: 5px;
    padding-right: 0;
    padding-bottom: 9px;
    padding-left: 11px;
    white-space: normal;
    background-size: 100% 100%;
    background-position-x: center 0;
    background-position-y: center 0;
    translate: 0 0;
    background-repeat: no-repeat no-repeat;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    word-spacing: 0;
    -unity-paragraph-spacing: 0;
    transition-duration: 0.2s, 0s;
}

.unity-enum-field > .unity-enum-field__input {
    margin-right: 102px;
}

#Normals > #SNormalTex {
    margin-right: 50px;
}

#Normals > #FNormalTex {
    margin-right: 50px;
    padding-left: 0;
    margin-left: 0;
}

#General > #generateGradientButton {
    font-size: 22px;
    -unity-font-style: bold;
    margin-left: 10px;
    margin-right: 10px;
    padding-bottom: 4px;
    padding-top: 4px;
    padding-right: 0;
    margin-bottom: 10px;
    margin-top: 10px;
    padding-left: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-color: rgba(0, 0, 0, 0.67);
    border-right-color: rgba(0, 0, 0, 0.67);
    border-top-color: rgba(0, 0, 0, 0.67);
    border-bottom-color: rgba(0, 0, 0, 0.67);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}
