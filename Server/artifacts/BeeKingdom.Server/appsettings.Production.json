{
  "BeeKingdom": {
    "EnableDiagnostics": true,
    "EnableBackgroundWorkers": true,
    "EventHistoryLimit": 4096
  },
  "ServerHost": {
    "HostingModel": "IIS",
    "TargetOperatingSystem": "Windows Server 2025",
    "SqlServerRole": "Dedicated Bee Kingdom SQL Server database - configure connection string outside source control"
  },
  "SqlServer": {
    "DatabaseName": "BeeKingdom",
    "ConnectionStringName": "BeeKingdomDb",
    "TablePrefix": "",
    "CommandTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
