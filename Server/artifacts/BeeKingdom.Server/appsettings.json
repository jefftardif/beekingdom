{
  "BeeKingdom": {
    "ServerName": "BeeKingdom.Server",
    "EnableDiagnostics": true,
    "EnableBackgroundWorkers": true,
    "EventHistoryLimit": 1024
  },
  "ServerHost": {
    "HostingModel": "IIS",
    "TargetOperatingSystem": "Windows Server 2025",
    "SqlServerRole": "Dedicated Bee Kingdom SQL Server database"
  },
  "SqlServer": {
    "DatabaseName": "BeeKingdom",
    "ConnectionStringName": "BeeKingdomDb",
    "ConnectionString": "Server=localhost;Database=BeeKingdom;Trusted_Connection=True;TrustServerCertificate=True;",
    "TablePrefix": "",
    "CommandTimeoutSeconds": 30
  },
  "Authentication": {
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "MaxSessionsPerAccount": 5,
    "MaxFailedAttempts": 5,
    "LockoutDuration": "00:10:00",
    "MinimumClientVersion": "1.0.0"
  },
  "Accounts": {
    "DefaultLanguage": "en-US",
    "DefaultTimeZone": "UTC",
    "DefaultCountry": "US",
    "DefaultCurrency": "USD"
  },
  "Gateway": {
    "MaxConnections": 10000,
    "ConnectionTimeout": "00:00:30",
    "HeartbeatInterval": "00:00:15",
    "MaxMessageBytes": 65536,
    "PlayerMessagesPerMinute": 120,
    "SessionMessagesPerMinute": 120,
    "IpMessagesPerMinute": 300,
    "MessageTypePerMinute": 240
  },
  "Colony": {
    "MaxSnapshotBytes": 1048576,
    "AutoSaveInterval": "00:05:00",
    "CompressionPolicy": "None",
    "RetentionDays": 30,
    "VersioningStrategy": "Semantic"
  },
  "Simulation": {
    "FixedTickInterval": "00:00:01",
    "AutoSaveEveryTicks": 300,
    "InactiveUnloadAfter": "00:15:00",
    "MaxFastForwardTicks": 10000,
    "MaxColoniesPerTickBatch": 1000,
    "SimulationEpochUtc": "1970-01-01T00:00:00+00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
