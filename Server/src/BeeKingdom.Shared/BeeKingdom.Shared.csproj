<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Single implementation for Unity and server-side read-only placement
       validation. No API endpoint or mutation is enabled by these links. -->
  <ItemGroup>
    <Compile Include="../../../Assets/BeeKingdom/Networking/MapPlacement.cs"
             Link="WorldMap/MapPlacement.cs" />
    <Compile Include="../../../Assets/BeeKingdom/Networking/SemanticTerrain.cs"
             Link="WorldMap/SemanticTerrain.cs" />
    <Compile Include="../../../Assets/BeeKingdom/Networking/ReviewedSemanticPlacementPlanner.cs"
             Link="WorldMap/ReviewedSemanticPlacementPlanner.cs" />
  </ItemGroup>
</Project>
