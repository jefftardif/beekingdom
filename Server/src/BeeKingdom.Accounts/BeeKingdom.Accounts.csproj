<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BeeKingdom.Shared\BeeKingdom.Shared.csproj" />
    <ProjectReference Include="..\BeeKingdom.Infrastructure\BeeKingdom.Infrastructure.csproj" />
    <ProjectReference Include="..\BeeKingdom.Persistence\BeeKingdom.Persistence.csproj" />
    <!-- M043P-CL: PlayerDirectoryService resolves the real, onboarded public DisplayName from
         BeeKingdom.Authentication's AuthenticationAccounts (the authoritative source, set via
         POST /auth/display-name) instead of the disconnected, never-populated DisplayName on
         this project's own Account record. No cycle: Authentication never references Accounts. -->
    <ProjectReference Include="..\BeeKingdom.Authentication\BeeKingdom.Authentication.csproj" />
    <!-- M043Q-CL: real implementation of BeeKingdom.Chat's IChatSenderDisplayNameResolver seam -
         resolves each message's SenderDisplayNameSnapshot from the same authoritative source
         (PlayerDirectoryService, see M043P) Alliance names already use. No cycle: BeeKingdom.Chat
         never references BeeKingdom.Accounts. -->
    <ProjectReference Include="..\BeeKingdom.Chat\BeeKingdom.Chat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
